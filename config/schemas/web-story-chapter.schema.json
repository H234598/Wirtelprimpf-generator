{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirtelprimpf.telacore.org/schemas/web-story-chapter.v1.json",
  "title": "Wirtelprimpf story chapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "timestamp", "markdown", "html", "sequence"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^band-[0-9]{4}-teil-[a-f0-9]{12}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"},
    "markdown": {"type": "string", "maxLength": 65536},
    "html": {"type": "string", "maxLength": 131072},
    "sequence": {"type": "integer", "minimum": 1}
  }
}
