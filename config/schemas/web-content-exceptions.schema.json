{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirtelprimpf.telacore.org/schemas/web-content-exceptions.v1.json",
  "title": "Wirtelprimpf content-model exceptions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "exceptions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "sha256", "reason", "expires_on", "severity"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "reason": {"type": "string", "minLength": 1},
          "expires_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "severity": {"enum": ["block", "warn"]}
        }
      }
    }
  }
}
