# Copy this file to a private environment file, then fill in your values.
# Never commit real API keys.

OPENAI_API_KEY=replace-me

# Where generated images and prompt text files are saved locally.
WIRTELPRIMPF_LOCAL_OUTDIR=$HOME/Hintergrundbilder
# Rotating copy of the latest output triplet.
WIRTELPRIMPF_WORKING_DIR=$HOME/Hintergrundbilder/working

# Active publication archive. The platform changes these two values atomically
# only after a verified five-book / 50-story rotation.
WIRTELPRIMPF_REPO_PATH=$HOME/.local/share/wirtelprimpf/archives/Wirtelprimpf-0001
WIRTELPRIMPF_REPO_SLUG=H234598/Wirtelprimpf-0001
WIRTELPRIMPF_REPO_SUBDIR=Wirtelprimpf
WIRTELPRIMPF_REPO_BRANCH=main
WIRTELPRIMPF_GITHUB_OWNER=H234598

# Images are immutable GitHub Release assets. Git main receives only prompt,
# story text and the publicly SHA-256-verified media manifest.
WIRTELPRIMPF_MEDIA_MODE=release
WIRTELPRIMPF_MEDIA_STAGING=$HOME/.local/state/wirtelprimpf/media-staging
WIRTELPRIMPF_PUBLISH_IMMEDIATELY=true

# Private restart-safe platform state and public generator catalog.
WIRTELPRIMPF_PLATFORM_STATE=$HOME/.local/state/wirtelprimpf/platform-state.json
WIRTELPRIMPF_HUB_DISPATCH_STATE=$HOME/.local/state/wirtelprimpf/hub-dispatch.json
WIRTELPRIMPF_GENERATOR_ROOT=$HOME/.local/share/wirtelprimpf-generator
WIRTELPRIMPF_ARCHIVE_ROOT=$HOME/.local/share/wirtelprimpf/archives
WIRTELPRIMPF_PLATFORM_CATALOG=$HOME/.local/share/wirtelprimpf-generator/data/publication-catalog.json
WIRTELPRIMPF_SETTINGS_PATH=$HOME/.config/wirtelprimpf/openai.env
WIRTELPRIMPF_CLOUDFLARE_ZONE=telacore.org
# Optional when it should be resolved through the Cloudflare API.
WIRTELPRIMPF_CLOUDFLARE_ZONE_ID=
# Optional explicit API token. Without it, the private Wrangler OAuth login at
# ~/.config/.wrangler/config/default.toml is refreshed and used automatically.
CLOUDFLARE_API_TOKEN=

# Git commit identity used for generated image commits.
WIRTELPRIMPF_GIT_AUTHOR_NAME=Wirtelprimpf Bot
WIRTELPRIMPF_GIT_AUTHOR_EMAIL=wirtelprimpf@example.invalid

# Publishing/versioning policy:
# - VERSION in wirtelprimpf_generator.py is the SemVer base.
# - Every committed generated image increments the SemVer patch component.
# - Major/minor changes are made by changing VERSION deliberately.
# - In release mode every verified publication commit is pushed immediately.
# - Legacy git-image mode retains the historical 100-commit fallback cadence.

# OpenAI image settings.
WIRTELPRIMPF_IMAGE_MODEL=gpt-image-2
WIRTELPRIMPF_IMAGE_SIZE=1536x1024
# Optional: toggle Flex Processing for OpenAI image generation.
# Default: on
# accepted values: on, off, true, false, yes, no, 1, 0, enabled, disabled
# accepted concrete mode: flex
# Keep this unset to keep Flex Processing on.
WIRTELPRIMPF_FLEX_PROCESSING=on


# Operandi:
# - classic / 1: bisherige Arbeitsweise, ein Bildprompt aus der ersten MD-Konfig.
# - story / 2: fortlaufende Geschichte aus zweiter MD-Konfig plus Bild zum Teil.
# - both / classic,story: beide Arbeitsweisen in einem Lauf.
WIRTELPRIMPF_OPERANDI=story

# Prompt settings. Copy Sourcecode/wirtelprimpf_prompt_config.md to this path
# and edit that private/local copy for personal prompt changes.
WIRTELPRIMPF_PROMPT_CONFIG=$HOME/.config/wirtelprimpf/prompt_config.md

# Operandi 2 settings. Copy Sourcecode/wirtelprimpf_story_prompt_config.md to
# this path. The story document is appended on each successful story run.
WIRTELPRIMPF_STORY_PROMPT_CONFIG=$HOME/.config/wirtelprimpf/story_prompt_config.md
WIRTELPRIMPF_STORY_MODEL=gpt-5-mini
WIRTELPRIMPF_STORY_DOCUMENT=$HOME/Hintergrundbilder/Wirtelprimpf_Story_I.md
WIRTELPRIMPF_STORY_STATE=$HOME/Hintergrundbilder/wirtelprimpf_story_state.json
# Versioned per-volume directives. The Cinnamon settings page edits the active
# story and the next two; finished stories remain visible read-only.
WIRTELPRIMPF_STORY_DIRECTIVES=$HOME/.config/wirtelprimpf/story_directives.json
# Set to true/on/1 to let the current story end over the next 3-5 story parts.
# After the final closing part, the next story part starts the next volume
# (for example Wirtelprimpf_Story_II.md). Each later off->on press advances
# the same way: Story_II closes into Story_III, then Story_IV, and so on.
# Turn it off once the request has been accepted.
WIRTELPRIMPF_STORY_FINISH=false
WIRTELPRIMPF_STORY_FINISH_PARTS_MIN=3
WIRTELPRIMPF_STORY_FINISH_PARTS_MAX=5

# Final output resolution. The API image is resized/cropped after generation.
# Supported aliases: 2k/qhd/1440p (2560x1440), 4k/uhd/2160p (3840x2160),
# original/source/none.
# Custom values like 1920x1080 are also accepted.
WIRTELPRIMPF_OUTPUT_RESOLUTION=2k

# Watcher tuning:
# - For direct script execution, set these in the shell environment.
# - For systemd service runtime, set them via service override (not via openai.env).
# poll interval in seconds:
SLEEP_SECONDS=300
# retry wait after running checks on version-change:
DEFAULT_RETRY_DELAY_SECONDS=5
# when fallback lock is older than this, it is reclaimed:
MAX_STALE_LOCK_SECONDS=900
