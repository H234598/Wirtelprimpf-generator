# Copy this file to a private environment file, then fill in your values.
# Never commit real API keys.

OPENAI_API_KEY=replace-me

# Where generated images and prompt text files are saved locally.
WIRTELPRIMPF_LOCAL_OUTDIR=$HOME/Hintergrundbilder

# Optional GitHub publishing. Leave WIRTELPRIMPF_REPO_PATH unset to generate
# locally only.
# Fill these only when publishing is enabled.
WIRTELPRIMPF_REPO_PATH=
WIRTELPRIMPF_REPO_SLUG=
WIRTELPRIMPF_REPO_SUBDIR=Wirtelprimpf
WIRTELPRIMPF_REPO_BRANCH=main

# Git commit identity used for generated image commits.
WIRTELPRIMPF_GIT_AUTHOR_NAME=Wirtelprimpf Bot
WIRTELPRIMPF_GIT_AUTHOR_EMAIL=wirtelprimpf@example.invalid

# Publishing policy (optional; defaults are documented in README):
# Publishing cadence (fixed, patch-based):
# - Every committed patch increments patch version (x.Y.Z).
# - Patch boundary is fixed at 100 commits: every 100 commits -> minor +1.
# - Minor boundary is fixed at 100 minor versions: every 100 minors -> major +1.
# - Patch commits below the minor boundary stay local; push only at minor boundary.
# - Release is prepared after 10 minor pushes.
#   (No automatic release is performed; this only emits a release-ready notice.)
# - Breaking changes/major features should force an explicit major bump.
# - Set WIRTELPRIMPF_MAJOR_VERSION_BUMP to add an extra major-step offset.
WIRTELPRIMPF_MAJOR_VERSION_BUMP=0
# Set to true/on/1 (or false/off/0) for one-off major bump control on this run.
WIRTELPRIMPF_BREAKING_CHANGE=false
# Keep fixed at 100. Any non-100 value is rejected by the runtime guard.
WIRTELPRIMPF_PATCHES_PER_MINOR=100
WIRTELPRIMPF_MINOR_PUSHES_PER_RELEASE=10

# OpenAI image settings.
WIRTELPRIMPF_IMAGE_MODEL=gpt-image-2
WIRTELPRIMPF_IMAGE_SIZE=1536x1024
# Optional: toggle Flex Processing for OpenAI image generation.
# Default: on
# accepted values: on, off, true, false, yes, no, 1, 0, enabled, disabled
# accepted concrete mode: flex
# Keep this unset to keep Flex Processing on.
WIRTELPRIMPF_FLEX_PROCESSING=on


# Operandi:
# - classic / 1: bisherige Arbeitsweise, ein Bildprompt aus der ersten MD-Konfig.
# - story / 2: fortlaufende Geschichte aus zweiter MD-Konfig plus Bild zum Teil.
WIRTELPRIMPF_OPERANDI=classic

# Prompt settings. Copy Sourcecode/wirtelprimpf_prompt_config.md to this path
# and edit that private/local copy for personal prompt changes.
WIRTELPRIMPF_PROMPT_CONFIG=$HOME/.config/wirtelprimpf/prompt_config.md

# Operandi 2 settings. Copy Sourcecode/wirtelprimpf_story_prompt_config.md to
# this path. The story document is appended on each successful story run.
WIRTELPRIMPF_STORY_PROMPT_CONFIG=$HOME/.config/wirtelprimpf/story_prompt_config.md
WIRTELPRIMPF_STORY_MODEL=gpt-5-mini
WIRTELPRIMPF_STORY_DOCUMENT=$HOME/Hintergrundbilder/wirtelprimpf_fortlaufende_geschichte.md

# Final output resolution. The API image is resized/cropped after generation.
# Supported aliases: 2k/qhd/1440p (2560x1440), 4k/uhd/2160p (3840x2160),
# original/source/none.
# Custom values like 1920x1080 are also accepted.
WIRTELPRIMPF_OUTPUT_RESOLUTION=2k

# Watcher tuning:
# - For direct script execution, set these in the shell environment.
# - For systemd service runtime, set them via service override (not via openai.env).
# poll interval in seconds:
SLEEP_SECONDS=300
# retry wait after running checks on version-change:
DEFAULT_RETRY_DELAY_SECONDS=5
# when fallback lock is older than this, it is reclaimed:
MAX_STALE_LOCK_SECONDS=900
