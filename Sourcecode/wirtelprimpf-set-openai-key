#!/usr/bin/env bash
set -euo pipefail

env_file="${1:-${HOME}/.config/wirtelprimpf/openai.env}"
if [[ -z "$env_file" ]]; then
  printf 'Environment file path must not be empty.\n' >&2
  exit 1
fi

config_dir="$(dirname -- "$env_file")"
if [[ -L "$config_dir" ]]; then
  printf 'Refusing to use symlinked config directory: %s\n' "$config_dir" >&2
  exit 1
fi

mkdir -p -- "$config_dir"
chmod 700 -- "$config_dir"

if [[ -L "$env_file" || ( -e "$env_file" && ! -f "$env_file" ) ]]; then
  printf 'Refusing to overwrite non-regular env file: %s\n' "$env_file" >&2
  exit 1
fi

printf 'OpenAI API key with Images permission (api.model.images.request): '
IFS= read -r -s api_key
printf '\n'

if [[ -z "$api_key" ]]; then
  printf 'No API key entered; nothing changed.\n' >&2
  exit 1
fi

umask 077
tmp_file="$(mktemp -- "${env_file}.XXXXXX")"
cleanup_tmp_file() {
  if [[ -n "${tmp_file:-}" && -e "$tmp_file" ]]; then
    rm -f -- "$tmp_file"
  fi
}
trap cleanup_tmp_file EXIT HUP INT TERM
printf 'OPENAI_API_KEY=%q\n' "$api_key" > "$tmp_file"
mv -- "$tmp_file" "$env_file"
tmp_file=""
chmod 600 -- "$env_file"

printf 'Saved: %s\n' "$env_file"
