[Unit]
Description=Generate one Wirtelprimpf image
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/wirtelprimpf/openai.env
Environment=WIRTELPRIMPF_OPERANDI=story
WorkingDirectory=%h/.local/share/wirtelprimpf-generator
ExecStart=%h/.local/share/wirtelprimpf-generator/.venv/bin/wirtelprimpf-generator
Restart=on-failure
RestartSec=5min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
UMask=0077
