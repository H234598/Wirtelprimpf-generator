[Unit]
Description=Generate one Wirtelprimpf atelier image
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/wirtelprimpf/openai.env
EnvironmentFile=-%h/.config/cloudflare/api-token.env
Environment=WIRTELPRIMPF_OPERANDI=classic
WorkingDirectory=%h/.local/share/wirtelprimpf-generator
RuntimeDirectory=wirtelprimpf-generator
RuntimeDirectoryMode=0700
Environment=TMPDIR=%t/wirtelprimpf-generator
Environment=TMP=%t/wirtelprimpf-generator
Environment=TEMP=%t/wirtelprimpf-generator
ExecStartPre=%h/.local/share/wirtelprimpf-generator/.venv/bin/python %h/.local/bin/wirtelprimpf-story-directives apply --env-file %h/.config/wirtelprimpf/openai.env
ExecStart=/usr/bin/flock --nonblock %t/wirtelprimpf-generator/generation.lock %h/.local/share/wirtelprimpf-generator/.venv/bin/wirtelprimpf-generator
NoNewPrivileges=true
PrivateTmp=false
PrivateDevices=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
UMask=0077
