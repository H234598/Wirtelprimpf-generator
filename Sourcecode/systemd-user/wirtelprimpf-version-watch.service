[Unit]
Description=Watch Wirtelprimpf version minor changes and run full checks
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/wirtelprimpf/github/Katzenbilder
ProtectHome=read-only
ReadWritePaths=%h/.local/share/wirtelprimpf/github/Katzenbilder
ExecStart=%h/.local/share/wirtelprimpf/github/Katzenbilder/Sourcecode/watch_minor_version.sh
Restart=always
RestartSec=10
Environment=SLEEP_SECONDS=300
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
StandardError=append:%h/.local/share/wirtelprimpf/github/Katzenbilder/Sourcecode/watch_service.log
StandardOutput=append:%h/.local/share/wirtelprimpf/github/Katzenbilder/Sourcecode/watch_service.log

[Install]
WantedBy=default.target
