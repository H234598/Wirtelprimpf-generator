[Unit]
Description=Watch Wirtelprimpf version minor changes and run full checks
After=default.target
StartLimitIntervalSec=5min
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/.local/share/wirtelprimpf-generator
RuntimeDirectory=wirtelprimpf-version-watch
RuntimeDirectoryMode=0700
ProtectHome=read-only
ReadWritePaths=%h/.local/share/wirtelprimpf-generator
ExecStart=%h/.local/share/wirtelprimpf-generator/Sourcecode/watch_minor_version.sh
Restart=on-failure
RestartSec=10
Environment=SLEEP_SECONDS=300
Environment=TMPDIR=%t/wirtelprimpf-version-watch
Environment=TMP=%t/wirtelprimpf-version-watch
Environment=TEMP=%t/wirtelprimpf-version-watch
UMask=0077
NoNewPrivileges=true
PrivateTmp=false
PrivateDevices=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
StandardError=journal
StandardOutput=journal

[Install]
WantedBy=default.target
