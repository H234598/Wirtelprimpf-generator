{
  "name": "@wirtelprimpf/site-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:browser": "playwright test tests/browser",
    "test:e2e": "node scripts/run-browser-gate.mjs",
    "test:visual-contract": "node --test --experimental-strip-types tests/visual-contract.test.ts",
    "test:performance": "playwright test tests/performance.spec.ts",
    "generate:catgpt-replies": "node scripts/generate-catgpt-static-replies.mjs",
    "build": "npm run build:status && astro build",
    "build:status": "python3 ../scripts/build_web_status.py --root .. --output src/generated/status.json",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "7.1.6",
    "marked": "18.0.7",
    "sanitize-html": "2.17.6",
    "sharp": "0.35.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/sanitize-html": "2.16.1",
    "axe-core": "4.12.1"
  }
}
