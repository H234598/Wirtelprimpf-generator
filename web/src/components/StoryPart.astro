---
import { classifyStoryPart, type StoryPart as StoryPartType } from "../lib/content.ts";
import { chapterAnchor } from "../lib/story-routes.ts";
interface Props { part: StoryPartType; newest?: boolean; chapterHref?: string; }
const { part, newest = false, chapterHref } = Astro.props;
const state = classifyStoryPart(part);
---
<article class:list={["story-part", { newest }]} id={part.id} data-content-state={state}>
  <header><span>Teil {part.sequence}</span><time datetime={part.timestamp.replace(" ", "T")}>{part.timestamp}</time>{newest && <strong>Neuester Teil</strong>}{chapterHref && <a class="chapter-link" href={chapterHref}>Kapitel öffnen</a>}</header>
  {state === "ready" ? <div class="prose" set:html={part.html} /> : <p class="empty-state" role="status">Dieses Kapitel ist leer und wird erst nach einer gültigen Veröffentlichung angezeigt.</p>}
  <a class="permalink" href={chapterHref ?? chapterAnchor(part.id)} aria-label={`Direktlink zu Teil ${part.sequence}`}>#</a>
</article>
