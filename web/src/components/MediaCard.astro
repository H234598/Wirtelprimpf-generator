---
import { mediaAltText, mediaKindLabel, type MediaItem } from "../lib/data.ts";
import MediaError from "./MediaError.astro";

interface Props { item: MediaItem; priority?: boolean; hidden?: boolean; }
const { item, priority = false, hidden = false } = Astro.props;
const small = item.variants[0];
const src = small?.url ?? item.original.url;
const srcset = item.variants.map((variant) => `${variant.url} ${variant.actual_width}w`).join(", ");
const label = mediaKindLabel(item.kind);
---
<article class="media-card" data-gallery-card data-kind={item.kind} data-year={item.year ?? "unknown"} hidden={hidden || undefined}>
  <a id={`gallery-card-${item.asset_id}`} data-gallery-return-link href={`/bilder/${item.asset_id}/`}>
    <div class="media-frame" data-media-frame style={`--ratio:${item.width}/${item.height}`}>
      <img data-media-image src={src} srcset={srcset || undefined} sizes="(max-width: 720px) 92vw, (max-width: 1100px) 45vw, 30vw" width={small?.actual_width ?? item.width} height={small?.actual_height ?? item.height} alt={mediaAltText(item)} loading={priority ? "eager" : "lazy"} fetchpriority={priority ? "high" : "auto"} decoding="async" />
      <MediaError />
      <span class="kind-badge">{label}</span>
    </div>
    <h3>{item.source_path.replace(/\.[^.]+$/, "").replaceAll("_", " ")}</h3>
    <p>Im Release <code>{item.release_tag}</code> archiviert.</p>
  </a>
  <button class="favorite-toggle" type="button" data-favorite-id={item.asset_id} hidden aria-pressed="false">Als Favorit merken</button>
</article>
