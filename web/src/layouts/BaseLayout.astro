---
import "../styles/global.css";
import CatGptWidget from "../components/CatGptWidget.astro";
import NoScriptNotice from "../components/NoScriptNotice.astro";
import Seo from "../components/Seo.astro";
import SettingsPanel from "../components/SettingsPanel.astro";
import {
  CATGPT_LIGHT_ORIGIN,
  resolveCatGptLightEndpoint,
} from "../lib/catgpt/config.ts";
import { loadSiteData } from "../lib/data.ts";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  section?: string;
}

const data = loadSiteData();
const { title = data.title, description = data.intro, image, section = "" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === data.title ? title : `${title} · ${data.title}`;
const centralUrl = "https://wirtelprimpf.telacore.org/";
const lightEndpoint = resolveCatGptLightEndpoint(import.meta.env.PUBLIC_CATGPT_LIGHT_ENDPOINT);
const contentSecurityPolicy = `default-src 'self'; img-src 'self' data: https://github.com https://*.githubusercontent.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ${lightEndpoint ? CATGPT_LIGHT_ORIGIN : "'none'"}; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <Seo title={fullTitle} description={description} canonical={canonical} image={image} contentSecurityPolicy={contentSecurityPolicy} />
    <script is:inline>
      document.documentElement.dataset.js = "enabled";
      try {
        const state = JSON.parse(localStorage.getItem("wirtelprimpf.site-state.v1") || "null");
        document.documentElement.dataset.theme = state?.theme === "paper" || (!state && localStorage.getItem("wirtelprimpf-theme") === "paper") ? "paper" : "night";
      } catch { document.documentElement.dataset.theme = "night"; }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label={`${data.title} – Startseite`}>
        <img src="/wirtelprimpf-mark.svg" width="52" height="52" alt="" />
        <span><small>{data.profile === "hub" ? "Telacores:" : `Publikationsarchiv ${String(data.archiveIndex).padStart(4, "0")}`}</small>{data.title}</span>
      </a>
      <nav aria-label="Hauptnavigation">
        <a href="/" aria-current={section === "start" ? "page" : undefined}>Start</a>
        <a href="/bilder/" aria-current={section === "bilder" ? "page" : undefined}>Bilder</a>
        <a href="/geschichten/" aria-current={section === "geschichten" ? "page" : undefined}>Geschichten</a>
        <a href="/projekt/" aria-current={section === "projekt" ? "page" : undefined}>Projekt</a>
      </nav>
      <div class="header-tools">
        <SettingsPanel />
        <CatGptWidget lightEndpoint={lightEndpoint} />
      </div>
    </header>
    <main id="inhalt"><slot /></main>
    <NoScriptNotice />
    <footer class="site-footer">
      <div><strong>Wirtelprimpf</strong><p>Fortlaufende Geschichten und Bilder, ruhig archiviert und frei zugänglich.</p></div>
      <div class="footer-links">
        {data.profile === "archive" && <a href={centralUrl}>Zur Zentrale</a>}
        <a href="/projekt/status/">Publikationsstatus</a>
        <a href={`https://github.com/H234598/${data.repository}`}>GitHub</a>
      </div>
    </footer>
  </body>
</html>
