---
import ArchiveCard from "../components/ArchiveCard.astro";
import MediaCard from "../components/MediaCard.astro";
import StoryPart from "../components/StoryPart.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortStoryPartsNewestFirst } from "../lib/content.ts";
import { archiveBookRange, loadSiteData } from "../lib/data.ts";

const data = loadSiteData();
const currentParts = data.currentStory ? sortStoryPartsNewestFirst(data.currentStory.parts) : [];
const latestMedia = data.media.slice(0, 6);
const archiveBooks = archiveBookRange(data.archiveIndex);
---
<BaseLayout section="start">
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">{data.profile === "hub" ? "Ein fortlaufendes Geschichtenuniversum" : `Bücher ${archiveBooks.bookStart}–${archiveBooks.bookEnd} · Storys ${(data.archiveIndex - 1) * 50 + 1}–${data.archiveIndex * 50}`}</span>
      <h1>Wo Katzen Unfug und Geschichte schreiben.</h1>
      <p class="lede">{data.intro} Hier landen neue Teile zuerst, ältere Abenteuer bleiben dauerhaft in ihren nummerierten Archiven erhalten.</p>
      <div class="button-row"><a href="#aktuelle-story">Neueste Story lesen</a><a href="/bilder/">Bilder entdecken →</a></div>
    </div>
    <div class="hero-art" aria-hidden="true"><div class="hero-orbit"><img src="/wirtelprimpf-mark.svg" width="240" height="240" alt="" /></div><p class="hero-note">Neuester Teil zuerst – damit du sofort weißt, was die Bande gerade anstellt.</p></div>
  </section>

  {data.profile === "hub" && <section class="section" aria-labelledby="archive-heading"><div class="section-heading"><div><span class="eyebrow">Das Regal</span><h2 id="archive-heading">Alle Publikationsarchive</h2></div><p>Je zehn abgeschlossene Storys ergeben ein Buch; nach fünf Büchern beziehungsweise 50 Storys entsteht automatisch das nächste Archiv.</p></div>{data.catalog.length ? <div class="archive-grid">{data.catalog.map((entry) => <ArchiveCard entry={entry} />)}</div> : <p class="empty-state">Das erste Archiv wird gerade für seine öffentliche Premiere vorbereitet.</p>}</section>}

  <section class="section" id="aktuelle-story" aria-labelledby="story-heading"><div class="section-heading"><div><span class="eyebrow">{data.currentStory ? `Buch ${data.currentStory.book} · Story ${data.currentStory.storyInBook} von 10 · letzter Teil zuerst` : "Letzter Teil zuerst"}</span><h2 id="story-heading">{data.currentStory?.title ?? "Die aktuelle Geschichte"}</h2></div><p>{currentParts.length ? `${currentParts.length} Teile in der aktuellen Story.` : "Sobald der nächste Storyteil veröffentlicht ist, erscheint er hier."}</p></div>{currentParts.length ? <div class="story-stream">{currentParts.map((part, index) => <StoryPart part={part} newest={index === 0} />)}</div> : <p class="empty-state">Noch kein veröffentlichter Storyteil im validierten Datenstand.</p>}</section>

  <section class="section" aria-labelledby="latest-images"><div class="section-heading"><div><span class="eyebrow">Aus dem Atelier</span><h2 id="latest-images">Neueste Bilder</h2></div><p>Kleine Webderivate laden schnell; das unveränderte Original bleibt mit SHA-256 im jeweiligen GitHub Release erhalten.</p></div>{latestMedia.length ? <div class="media-grid">{latestMedia.map((item, index) => <MediaCard item={item} priority={index === 0} />)}</div> : <p class="empty-state">Die Release-Medien werden am verifizierten Migrationsgate zugeschaltet.</p>}</section>
</BaseLayout>
