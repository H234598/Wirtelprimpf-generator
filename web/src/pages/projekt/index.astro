---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadSiteData } from "../../lib/data.ts";
const data=loadSiteData();
---
<BaseLayout title="Projekt" section="projekt">
  <header class="page-heading"><span class="eyebrow">Hinter den Kulissen</span><h1>Ein Archiv, das mit seiner Geschichte wächst.</h1><p class="lede">Generator und Publikationsarchive sind getrennt. Zehn abgeschlossene Storys bilden ein Buch; jedes Archiv umfasst fünf Bücher beziehungsweise 50 Storys. Originalbilder liegen prüfsummengebunden in GitHub Releases.</p></header>
  <section class="section" style="padding-top:1rem"><div class="archive-grid"><article class="archive-card"><span class="eyebrow">Reproduzierbar</span><h2>Ein Datenstand, ein Build</h2><p>Schema-validierte Manifeste, stabile IDs und statische Ausgaben machen jede Veröffentlichung nachvollziehbar.</p></article><article class="archive-card"><span class="eyebrow">Zugänglich</span><h2>Lesbar ohne Zwangs-JavaScript</h2><p>Navigation, Galerie und Geschichten funktionieren als statisches Fundament. Kleine Ergänzungen bleiben optional.</p></article><article class="archive-card"><span class="eyebrow">Beständig</span><h2>Keine stille Umschreibung</h2><p>Medienumzüge werden öffentlich heruntergeladen und gegen SHA-256 geprüft. Historie bleibt erhalten.</p></article></div></section>
  <section class="section"><div class="archive-grid"><article class="archive-card"><span class="eyebrow">Provenienz</span><h2>Eingefrorene Referenzen</h2><p>Generator, Archive und technische Referenzen werden über feste Commit-SHAs benannt. Eine Lizenzfreigabe wird nur dort behauptet, wo sie tatsächlich vorliegt.</p><div class="card-actions"><a href="https://github.com/H234598/Wirtelprimpf-generator/blob/main/PROVENANCE.md" rel="noopener noreferrer">Provenienz öffnen</a></div></article><article class="archive-card"><span class="eyebrow">Wartung</span><h2>Redigierter Status</h2><p>Öffentlich erscheinen nur Revision, Inhaltszahlen und Freshness. Interne Laufberichte, Pfade und Diagnosetraces bleiben außerhalb des Sites.</p><div class="card-actions"><a href="/projekt/status/">Status ansehen</a></div></article></div></section>
  <section class="section"><div class="section-heading"><div><span class="eyebrow">Quellen & Provenienz</span><h2>Offen nachvollziehbar</h2></div><p>Diese Seite wurde aus dem geprüften Repositoryzustand gebaut.</p></div><div class="button-row"><a href={`https://github.com/H234598/${data.repository}`}>Repository öffnen</a><a href="/projekt/status/">Status ansehen →</a></div></section>
</BaseLayout>
