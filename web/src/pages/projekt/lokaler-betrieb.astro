---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadReadmeSections } from "../../lib/readme.ts";

const sectionIds = [
  "lokaler-betrieb",
  "transaktionale-einstellungen-und-betriebsstatus",
  "backup-und-wiederherstellung",
] as const;
const sections = loadReadmeSections([
  "Lokaler Betrieb",
  "Transaktionale Einstellungen und Betriebsstatus",
  "Backup und Wiederherstellung",
]).map((section, index) => ({ ...section, id: sectionIds[index]! }));
---
<BaseLayout title="Lokaler Betrieb" section="projekt">
  <header class="page-heading"><span class="eyebrow">Projektbetrieb</span><h1>Lokaler Betrieb</h1></header>
  <section class="section readme-document" aria-label="Dokumentation zum lokalen Betrieb">
    {sections.map((section) => <section class="readme-section" id={section.id} aria-labelledby={`${section.id}-heading`}><h2 id={`${section.id}-heading`}>{section.title}</h2><div class="prose" set:html={section.html} /></section>)}
  </section>
</BaseLayout>
