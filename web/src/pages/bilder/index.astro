---
import MediaCard from "../../components/MediaCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadSiteData } from "../../lib/data.ts";
const data = loadSiteData();
const pageItems = data.media.slice(0, 24);
const pageCount = Math.max(1, Math.ceil(data.media.length / 24));
---
<BaseLayout title="Bilder" description="Storybilder, Atelierbilder und historische Wirtelprimpf-Motive." section="bilder">
  <header class="page-heading"><span class="eyebrow">Galerie</span><h1>Bilder aus dem Geschichtenatelier</h1><p class="lede">Release-gebundene Originale, leichtgewichtige Vorschauen und nachvollziehbare Provenienz.</p></header>
  <section class="section" style="padding-top:1rem"><div class="filter-bar" aria-label="Galeriefilter"><button type="button" aria-pressed="true" data-filter="all">Alle</button><button type="button" aria-pressed="false" data-filter="story">Story</button><button type="button" aria-pressed="false" data-filter="classic">Atelier</button><button type="button" aria-pressed="false" data-filter="legacy">Historisch</button></div>{pageItems.length ? <div class="media-grid" data-gallery>{pageItems.map((item, index) => <MediaCard item={item} priority={index < 2} />)}</div> : <p class="empty-state">Noch keine verifizierten Release-Medien.</p>}{pageCount > 1 && <nav class="pagination" aria-label="Galerieseiten">{Array.from({length:pageCount},(_,index)=><a href={index === 0 ? "/bilder/" : `/bilder/seite/${index+1}/`} aria-current={index === 0 ? "page" : undefined}>{index+1}</a>)}</nav>}</section>
  <script is:inline>
    const buttons=[...document.querySelectorAll('[data-filter]')];
    buttons.forEach(button=>button.addEventListener('click',()=>{buttons.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));document.querySelectorAll('[data-gallery] .media-card').forEach(card=>{card.hidden=button.dataset.filter!=='all'&&card.dataset.kind!==button.dataset.filter})}));
  </script>
</BaseLayout>
