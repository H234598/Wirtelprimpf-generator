---
import MediaCard from "../../../components/MediaCard.astro";
import EmptyState from "../../../components/EmptyState.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { loadSiteData, mediaKindLabel, type MediaKind } from "../../../lib/data.ts";
import { availableGalleryYears, galleryPagePath, galleryUrl, type GalleryState } from "../../../lib/routes.ts";
export function getStaticPaths() { const pageSize=24; const media=loadSiteData().media; const pages=Math.ceil(media.length/pageSize); return Array.from({length:Math.max(0,pages-1)},(_,index)=>{const page=index+2;return {params:{page:String(page)},props:{page,items:media.slice((page-1)*pageSize,page*pageSize),pages}}}); }
const { page, items, pages } = Astro.props;
const data = loadSiteData();
const years = availableGalleryYears(data.media);
const types: Array<GalleryState["typ"]> = ["all", "story", "classic", "legacy", "unknown"];
const labelForType = (type: GalleryState["typ"]): string => type === "all" ? "Alle" : mediaKindLabel(type as MediaKind);
const hrefFor = (state: GalleryState): string => galleryUrl("/bilder/", { ...state, seite: 1 });
---
<BaseLayout title={`Bilder · Seite ${page}`} section="bilder">
  <header class="page-heading"><span class="eyebrow">Galerie</span><h1>Bilder · Seite {page}</h1></header>
  <section class="section" style="padding-top:1rem" data-gallery-root data-gallery-page={page} data-gallery-page-count={pages} data-gallery-years={years.join(",")} aria-labelledby="galerie-ergebnisse">
    <nav class="filter-bar" aria-label="Galerietyp"><span class="visually-hidden">Typ:</span>{types.map((type) => <a id={`galerie-filter-${type}`} href={hrefFor({ typ: type, seite: page, jahr: null })} data-gallery-filter={type} aria-current={type === "all" ? "page" : "false"}>{labelForType(type)}</a>)}</nav>
    <nav class="filter-bar" aria-label="Galeriejahr"><span class="visually-hidden">Jahr:</span><a id="galerie-year-all" href={hrefFor({ typ: "all", seite: page, jahr: null })} data-gallery-year="" aria-current="page">Alle Jahre</a>{years.map((year) => <a id={`galerie-year-${year}`} href={hrefFor({ typ: "all", seite: page, jahr: year })} data-gallery-year={year} aria-current="false">{year}</a>)}</nav>
    <p id="galerie-status" data-gallery-status role="status" aria-live="polite">{items.length} Bilder in diesem Seitenstand.</p>
    <h2 id="galerie-ergebnisse" data-gallery-focus tabindex="-1" class="visually-hidden">Galerieergebnisse</h2>
    <div class="media-grid" data-gallery>{items.map((item)=><MediaCard item={item} />)}</div>
    <EmptyState hidden>Keine Bilder entsprechen diesem Filter.</EmptyState>
    <nav class="pagination" aria-label="Galerieseiten">{Array.from({length:pages},(_,index)=><a href={galleryPagePath(index + 1)} data-gallery-pagination data-gallery-page={index + 1} aria-current={index+1===page?"page":undefined}>{index+1}</a>)}</nav>
  </section>
  <script src="../../../scripts/gallery-state.ts"></script>
  <script src="../../../scripts/favorites.ts"></script>
  <script src="../../../scripts/media-fallback.ts"></script>
</BaseLayout>
